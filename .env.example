NODE_ENV=development
PORT=3000
APP_NAME=template-ts-backend
APP_VERSION=0.1.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template_ts_backend
TRUST_IDENTITY_HEADER=true
MAX_BODY_BYTES=1048576
# JWT validation against the product's JWKS. When JWKS_URL is set, protected
# routes validate Bearer tokens instead of trusting the x-user-id header.
# JWKS_URL=https://auth.example.com/api/auth/jwks
# JWT_ISSUER=https://auth.example.com
# JWT_AUDIENCE=template-ts-backend
# Host port for the local Postgres container; change it if 5432 is taken.
POSTGRES_PORT=5432
