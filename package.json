{
  "name": "template-ts-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "TypeScript backend template: Hono, OpenAPI, Zod, Drizzle, Postgres",
  "scripts": {
    "start": "bun src/index.ts",
    "start:node": "node dist/node.js",
    "prepare": "node -e \"const fs=require('node:fs');if(fs.existsSync('.git')&&fs.existsSync('node_modules/lefthook'))require('node:child_process').execSync('lefthook install',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.0.0",
    "drizzle-kit": "^0.31.11",
    "fallow": "3.37.0",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "overrides": {
    "esbuild": "^0.28.2",
    "katex": "^0.18.2"
  }
}
