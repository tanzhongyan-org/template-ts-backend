{
  "name": "template-ts-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "High-performance TypeScript backend template powered by Hono, OpenAPI 3.1, Zod 4, and Scalar",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:node": "tsx watch src/node.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun src/index.ts",
    "start:node": "node dist/node.js",
    "typecheck": "tsc --noEmit",
    "check:deadcode": "knip",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test && npx --yes fallow@3.33.1 dupes --quiet --no-fragments && npx --yes --package @ast-grep/cli ast-grep scan",
    "prepare": "node -e \"const fs=require('node:fs');if(fs.existsSync('.git')&&fs.existsSync('node_modules/lefthook'))require('node:child_process').execSync('lefthook install',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.14",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^24.2.0",
    "knip": "^5.45.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "packageManager": "bun@1.4.3"
}
